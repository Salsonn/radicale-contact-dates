{
  "future_days": 730,
  "past_days": 365,
  "blacklist_note_marker": "#NB",
  "month_names": [
    "", "januari", "februari", "maart", "april", "mei", "juni",
    "juli", "augustus", "september", "oktober", "november", "december"
  ],
  "date_format": "{day} {month}",
  "suffix": "-auto-contact-dates",
  "displayname_prefix": "Contactdatums",
  "prodid": "-//radicale-contact-dates//EN",
  "collections": {
    "*/contacts": {"enabled": true},
    "*/archived-contacts": {"enabled": false}
  },
  "date_types": {
    "birthday": {
      "enabled": true,
      "source": "BDAY",
      "category": "Verjaardag",
      "reminders": [
        {"days_before": 0, "at": "11:30", "type": "event",
         "template": "🎂 {name} is jarig ({count} jaar)",
         "template_unknown": "🎂 {name} is jarig"},
        {"days_before": 7, "at": "11:30", "type": "event",
         "template": "🎂 {name} is volgende week jarig op {date} ({count} jaar)",
         "template_unknown": "🎂 {name} is volgende week jarig op {date}"},
        {"days_before": 1, "at": "11:30", "type": "event",
         "template": "🎂 {name} is morgen jarig ({count} jaar)",
         "template_unknown": "🎂 {name} is morgen jarig"}
      ]
    },
    "anniversary": {
      "enabled": true,
      "source": "ANNIVERSARY",
      "apple_label": "Anniversary",
      "category": "Jubileum",
      "reminders": [
        {"days_before": 0, "at": "11:30", "type": "event",
         "template": "💍 {name} — {count}e jubileum",
         "template_unknown": "💍 {name} — jubileum"},
        {"days_before": 7, "at": "11:30", "type": "event",
         "template": "💍 {name} — volgende week {count}e jubileum op {date}",
         "template_unknown": "💍 {name} — volgende week jubileum op {date}"},
        {"days_before": 1, "at": "11:30", "type": "event",
         "template": "💍 {name} — morgen {count}e jubileum",
         "template_unknown": "💍 {name} — morgen jubileum"}
      ]
    },
    "other_dates": {
      "enabled": false,
      "match": "x-abdate-any",
      "category": "Belangrijke datum",
      "reminders": [
        {"days_before": 0, "at": "11:30", "type": "event",
         "template": "📅 {name} — {label} ({count})",
         "template_unknown": "📅 {name} — {label}"},
        {"days_before": 7, "at": "11:30", "type": "event",
         "template": "📅 {name} — {label} op {date} ({count})",
         "template_unknown": "📅 {name} — {label} op {date}"},
        {"days_before": 1, "at": "11:30", "type": "event",
         "template": "📅 {name} — morgen {label} ({count})",
         "template_unknown": "📅 {name} — morgen {label}"}
      ]
    }
  }
}
